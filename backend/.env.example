# Copy this file to ".env" and put your real values there.
# The ".env" file is secret. Never share it or push it to GitHub.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=employee-sys
DATABASE_USER=postgres
# Only the password here, not a full "postgresql://..." address
DATABASE_PASSWORD=put-your-postgres-password-here

# A long random secret used to sign login tokens.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET_KEY=put-a-long-random-secret-here

# How many minutes a login token stays valid
TOKEN_LIFETIME_MINUTES=60
